{
  "name": "@appreciator/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp -R src/db/migrations/. dist/db/migrations && mkdir -p dist/web dist/site && cp -R src/web/. dist/web && cp -R ../../site/. dist/site",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "create-tenant": "tsx src/create-tenant.ts",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration"
  },
  "dependencies": {
    "@appreciator/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
